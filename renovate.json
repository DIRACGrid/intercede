{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>DIRACGrid/.github//renovate-config"
  ],
  "enabledManagers": [
    "pip_requirements",
    "pep621",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "custom.regex"
  ],
  "python": {
    "rangeStrategy": "auto"
  },
  "ignorePaths": [
    ".pixi/**",
    "**/__pycache__/**",
    "**/venv/**",
    "**/env/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track pinned backend versions in stack image Dockerfiles via `# renovate:`-annotated ARGs. The datasource/depName/versioning ride in the annotation, so a new stack image needs no renovate.json edit.",
      "fileMatch": [
        "(^|/)tests/integration/stacks/_images/.+/Dockerfile$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s+ARG [A-Za-z0-9_]+?_VERSION=\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}loose{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group all Python dependency updates together",
      "matchManagers": [
        "pip_requirements",
        "pep621"
      ],
      "groupName": "Python dependencies",
      "labels": [
        "dependencies",
        "python"
      ]
    },
    {
      "description": "Group build dependencies",
      "matchPackagePatterns": [
        "hatchling",
        "hatch-vcs"
      ],
      "groupName": "Build dependencies",
      "labels": [
        "dependencies",
        "build"
      ]
    },
    {
      "description": "Group test dependencies",
      "matchPackagePatterns": [
        "pytest.*",
        "ty"
      ],
      "groupName": "Testing dependencies",
      "labels": [
        "dependencies",
        "testing"
      ]
    },
    {
      "description": "Group ARC backend bumps, never mixed with other backends so a red PR names its culprit. Renovate tracks the leading-edge ARG; anchors are human-managed.",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "custom.regex"
      ],
      "matchPackageNames": [
        "/nordugrid-arc/"
      ],
      "groupName": "ARC backend (integration stack)",
      "labels": [
        "dependencies",
        "integration-stack",
        "arc"
      ]
    },
    {
      "description": "Group HTCondor / HTCondor-CE backend bumps",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "custom.regex"
      ],
      "matchPackageNames": [
        "/htcondor/"
      ],
      "groupName": "HTCondor backend (integration stack)",
      "labels": [
        "dependencies",
        "integration-stack",
        "htcondor"
      ]
    },
    {
      "description": "Group Slurm backend bumps",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "custom.regex"
      ],
      "matchPackageNames": [
        "/slurm/"
      ],
      "groupName": "Slurm backend (integration stack)",
      "labels": [
        "dependencies",
        "integration-stack",
        "slurm"
      ]
    }
  ]
}
